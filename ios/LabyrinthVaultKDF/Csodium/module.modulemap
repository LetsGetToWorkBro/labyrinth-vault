// libsodium, as a module Swift can import.
//
// A system-library target: this points at a libsodium the platform already
// has, which is how `swift test` reaches it on Linux and on a Mac with
// Homebrew. It is deliberately *not* how the iOS app will get libsodium —
// there is no system libsodium on a phone — and that packaging is a separate
// step. See ios/LabyrinthVaultKDF/README.md.
module Csodium [system] {
    header "shim.h"
    link "sodium"
    export *
}
