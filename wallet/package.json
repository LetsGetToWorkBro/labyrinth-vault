{
  "name": "labyrinth-wallet",
  "version": "0.1.0",
  "description": "The online half of Labyrinth: a Bitcoin and Monero wallet that watches accounts paired from an airgapped vault, prepares transactions, hands them over as QR frames, and broadcasts what comes back signed. It can also hold a smaller wallet of its own, whose seed lives in the device keychain.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@noble/ciphers": "^2.3.0",
    "@noble/curves": "2.3.0",
    "@noble/hashes": "2.3.0",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "@scure/bip32": "2.3.0",
    "@scure/bip39": "2.3.0",
    "@scure/btc-signer": "2.3.0",
    "expo": "^57.0.12",
    "expo-blur": "~57.0.2",
    "expo-camera": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-document-picker": "57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-local-authentication": "~17.0.1",
    "expo-secure-store": "57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "57.0.2",
    "qrcode": "1.5.4",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
