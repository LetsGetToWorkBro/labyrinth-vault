{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "types": ["react", "node"],
    "paths": {
      "@vault/*": ["../src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["App.tsx", "index.ts", "src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "scripts/**/*.ts"]
}
