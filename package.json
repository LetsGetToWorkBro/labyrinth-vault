{
  "name": "labyrinth-vault",
  "version": "0.1.0",
  "private": true,
  "description": "An airgapped signing device for Bitcoin and Monero. Keys are made and signatures are given on a phone that never touches a network; QR codes are the only wire.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "npm run build:bundle && vitest run",
    "typecheck": "tsc --noEmit",
    "build:bundle": "node scripts/build-bundle.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@noble/ciphers": "2.3.0",
    "@noble/curves": "2.3.0",
    "@noble/hashes": "2.3.0",
    "@scure/bip32": "2.3.0",
    "@scure/bip39": "2.3.0",
    "@scure/btc-signer": "2.3.0"
  }
}
