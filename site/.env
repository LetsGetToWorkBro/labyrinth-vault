# Where this site is served from. Only used to build the absolute og:image URL
# in index.html, which social scrapers will not resolve from a relative path.
#
# Set the same value in the Cloudflare Pages project, for production and
# preview both, or a preview deploy will advertise a picture at an address it
# is not serving from.
VITE_SITE_ORIGIN=https://labyrinthwallet.com
