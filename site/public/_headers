# Headers Cloudflare applies to the built site.
#
# ## The rule that makes this file subtle
#
# **Every matching rule is appended, not overridden.** A path that matches two
# blocks gets both values, joined with a comma, in one header. There is no
# most-specific-wins. The first version of this file set `Cache-Control` in
# `/*` as well as in `/assets/*`, and every hashed asset came back as:
#
#   cache-control: public, max-age=0, must-revalidate, public, max-age=31536000, immutable
#
# which starts with `max-age=0`, is what a cache reads first, and quietly
# undid the entire point of fingerprinting the assets.
#
# So `Cache-Control` appears in exactly one block per path here, and `/*`
# carries no caching at all. It does not need to: Cloudflare's own default for
# an unmatched file is already `public, max-age=0, must-revalidate`, which is
# what `index.html` wants, and letting the platform say it is the only way to
# be sure nothing is said twice.

/assets/*
  # Everything Vite emits is named with a hash of its own contents, so an old
  # name can never go stale. This is the whole of the caching policy; the
  # media lives here too, which is why there are no rules by file extension.
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/og.jpg
  Cache-Control: public, max-age=604800

/*
  # No Cache-Control here, deliberately. See the note above.
  #
  # This is a static page. It runs its own bundle, loads its own media, and
  # talks to nothing. Saying so in a header means a script injected by any
  # future mistake has nowhere to send what it finds.
  #
  # `blob:` on media-src is load-bearing and easy to delete by mistake. The
  # hero fetches its clip, wraps it in a Blob and hands the video element an
  # object URL, which is how it can scrub a downloaded file rather than stream
  # one. A blob: URL is not covered by 'self', so without it the video errors,
  # the component removes it, and the hero is a black rectangle with a loader
  # that never resolves. It grants nothing extra: a blob can only come from
  # something this page already fetched under connect-src.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
