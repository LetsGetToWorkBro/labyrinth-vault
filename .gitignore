node_modules/
dist/
.DS_Store
wallet/node_modules/
wallet/.expo/

# Generated by `npx expo prebuild` from wallet/app.json, on the Mac and in the
# dry run alike. Never edited by hand, so never committed: the config is the
# source and test/shipping.test.ts is what holds the config.
wallet/ios/
wallet/android/

# SwiftPM build products (Package.swift builds the platform-free model).
.build/

# The swap Worker's dependencies and wrangler state.
worker/node_modules/
worker/.wrangler/

# Generated by scripts/make-fastlane.mjs from store/, which is the tested
# source. Regenerate rather than edit; a committed copy is a second set of
# claims with none of the checking.
fastlane/*/metadata/
fastlane/*/screenshots/
