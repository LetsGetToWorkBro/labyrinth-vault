node_modules/
dist/
.DS_Store
wallet/node_modules/
wallet/.expo/

# Generated by `npx expo prebuild` from wallet/app.json, on the Mac and in the
# dry run alike. Never edited by hand, so never committed: the config is the
# source and test/shipping.test.ts is what holds the config.
wallet/ios/
wallet/android/

# SwiftPM build products (Package.swift builds the platform-free model).
.build/

# The swap Worker's dependencies and wrangler state.
worker/node_modules/
worker/.wrangler/

# Generated by scripts/make-fastlane.mjs from store/, which is the tested
# source. Regenerate rather than edit; a committed copy is a second set of
# claims with none of the checking.
fastlane/*/metadata/
fastlane/*/screenshots/

# Generated by `xcodegen generate` from ios/project.yml, never committed.
# Ignored rather than merely untracked: both show up in `git status`, and an
# untracked generated file is one `git add -A` away from being committed and
# then silently overriding the manifest that is supposed to produce it. The
# Info.plist is the one that would hurt, since a stale copy is how a key the
# manifest no longer sets survives into an archive.
ios/LabyrinthVault.xcodeproj/
ios/LabyrinthVault/Info.plist

# Rendered by test/shipping.test.ts to compare against the committed icons
# without writing over them. See the comment in that test.
.icons-check/

# Upstream checkouts and throwaway build harnesses used while vendoring C.
# vendor/ is the committed result; this is the working area that produced it,
# and a shallow clone of Monero is not something to carry in this history.
scratchpad/
