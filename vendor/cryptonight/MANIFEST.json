  "takenFor": "cn_slow_hash at variant 0, which is the hash crypto::generate_chacha_key runs to turn a Monero view secret key into the ChaCha20 key over an exported key-image set. See ios/LabyrinthVaultKDF/README.md.",
  "ours": [
    "include/labyrinth_cryptonight.h",
    "shim/labyrinth_cn.c",
    "shim/boost/preprocessor/stringize.hpp"
  ],
  "buildDefines": {
    "NO_AES": "Selects the portable C implementation in slow-hash.c over the AES-NI and ARM-NEON ones. Same output — all three are checked against the official vectors — and it is the same reasoning that took ref.c over opt.c for Argon2: one code path, and the one a Linux CI can actually run.",
    "FORCE_USE_HEAP": "The portable path otherwise declares its 2 MiB scratchpad as a stack array, and an iOS thread has 512 KiB."
  },
  "notTaken": [
    "src/crypto/CryptonightR_JIT.c and CryptonightR_template.{S,h} (runtime code generation, reached only at variant 4, and iOS forbids the mmap it needs)",
    "src/crypto/rx-slow-hash.c and RandomX (variant 5; tens of thousands of lines for a call this app never makes)",
    "src/crypto/crypto-ops.c, crypto.cpp, generators.cpp (the elliptic curve; the engine does that in TypeScript)",
    "src/crypto/chacha.c (the stream cipher itself; src/keys/monerotx.ts has it)",
    "src/crypto/tree-hash.c, hmac-keccak.c, blake2b.c, random.c (unreached from cn_slow_hash)"
  ],
